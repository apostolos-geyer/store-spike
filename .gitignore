node_modules/

# Alchemy's local state and build output.
#
# NOT just size (110M of bundles) — `state/` holds the RESOLVED value of every
# `Config` the workers read, which means the Stripe secret key and the webhook
# signing secret are in there in PLAINTEXT. Committing this directory publishes
# them.
.alchemy/

.env
.env.*
!.env.example
.DS_Store

# The console's build output. Produced by `ConsoleBuild` on every deploy and
# uploaded straight to Cloudflare's asset store, so it is never a source input.
console/dist/
